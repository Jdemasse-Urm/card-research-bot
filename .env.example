# Copy to .env (or just paste your key in the app's Settings screen).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Optional
# PORT=3737
# CARD_BOT_MODEL=gemini-3.8-flash      # e.g. gemini-3.5-flash-lite for cheaper/faster
# CARD_BOT_MONTHLY_BUDGET=10            # stop AI jobs once the estimated monthly cost hits this ($)
# CARD_BOT_PRICE_IN=0.75                # paid-tier $/1M input tokens, for the cost estimate
# CARD_BOT_PRICE_OUT=3.75               # paid-tier $/1M output tokens
# SHARE_ON_NETWORK=1                    # let other computers on your Wi-Fi use the bot (needs ACCESS_PIN)
# ACCESS_PIN=1234
# NO_BROWSER=1                          # don't auto-open the browser on start
