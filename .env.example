# Copy to .env (or just paste keys in the app's Settings screen — that writes this file for you).

# Required for AI research — free: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Optional connections
# PSA_API_TOKEN=...                  # slab verification, population, grading progress — psacard.com/publicapi
# EBAY_CLIENT_ID=...                 # deal finder — developer.ebay.com, Production keyset "App ID"
# EBAY_CLIENT_SECRET=...             #                                         "Cert ID"

# Optional settings
# PORT=3737                          # tries the next port automatically if this one is busy
# CARD_BOT_MODEL=gemini-3.8-flash
# CARD_BOT_FALLBACK_MODEL=gemini-3.5-flash-lite   # used when the main model is out of quota; "off" to disable
# CARD_BOT_MONTHLY_BUDGET=10         # stop AI jobs once the estimated monthly cost hits this ($)
# CARD_BOT_PRICE_IN=0.75             # paid-tier $/1M input tokens, for the cost estimate
# CARD_BOT_PRICE_OUT=3.75            # paid-tier $/1M output tokens
# CARD_BOT_DAILY_BRIEF=1             # scan today's hottest cards each morning while the bot is open
# CARD_BOT_BRIEF_HOUR=8              # ...after this hour (24h clock)
# SHARE_ON_NETWORK=1                 # let other computers/phones on your Wi-Fi use the bot (needs ACCESS_PIN)
# ACCESS_PIN=1234
# NO_BROWSER=1                       # don't auto-open the browser on start
